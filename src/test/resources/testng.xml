<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="POM Framework Suite">

    <listeners>
        <listener class-name="listeners.ExecutionListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.framework.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Rough Tests">
        <classes>
            <class name="com.framework.tests.Rough.Rough"/>
        </classes>
    </test>

</suite>